@echo off
title JobComm RTAF - อัปเดตเว็บไซต์ขึ้น Cloud
cd /d "%~dp0"
chcp 65001 >nul

echo ========================================================
echo   ระบบอัปเดตเว็บไซต์ JobComm RTAF (Auto Deploy)
echo ========================================================
echo.
echo * หมายเหตุ: การอัปเดตนี้จะเปลี่ยนเฉพาะหน้าตาเว็บ/โค้ดโปรแกรม
echo * ฐานข้อมูลภารกิจและรูปภาพบน Supabase จะยังอยู่ครบถ้วน 100%%
echo ========================================================
echo.

set /p msg="ระบุรายละเอียดสิ่งที่แก้ไข (หรือกด Enter เพื่อใช้ค่าเริ่มต้น): "
if "%msg%"=="" set msg=Update website UI and features

echo.
echo [1/3] บันทึกการเปลี่ยนแปลงโค้ด...
git add .

echo [2/3] สร้าง Commit: %msg%
git commit -m "%msg%"

echo [3/3] ส่งโค้ดขึ้น GitHub (Render จะ Deploy อัตโนมัติ)...
git push origin main

echo.
echo ========================================================
if %errorlevel% equ 0 (
    echo  [OK] ส่งโค้ดขึ้นระบบเรียบร้อยแล้ว!
    echo  - Render จะเริ่มอัปเดตหน้าเว็บให้อัตโนมัติ (ใช้เวลาประมาณ 1-2 นาที)
    echo  - หน้าเว็บออนไลน์จะเปลี่ยนเป็นเวอร์ชันใหม่ทันที
) else (
    echo  [!] เกิดข้อผิดพลาดในการส่งโค้ด กรุณาตรวจสอบการเชื่อมต่ออินเทอร์เน็ต
)
echo ========================================================
pause
